# Copy to .env and fill in. NEVER commit the real .env — it holds secrets.
# docker compose reads this file automatically.

# --- Identity + relay (required) ---
BUZZ_RELAY_URL=wss://relay.example.com
# The agent's OWN Nostr secret key (its identity + git-push credential).
# Generate a fresh one per agent: `buzz users keygen`.
BUZZ_PRIVATE_KEY=nsec1replace_with_this_agents_own_secret_key
# YOUR pubkey (64-char hex) — lets owner-only gating admit you.
BUZZ_ACP_AGENT_OWNER=replace_with_your_64_char_hex_pubkey

# --- Runtime + model credentials ---
# claude-agent-acp | codex-acp | goose | buzz-agent
BUZZ_ACP_AGENT_COMMAND=claude-agent-acp
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Routing (see AGENT_SETUP.md §7) ---
# mentions | all | config   (config = use buzz-acp.toml)
BUZZ_ACP_SUBSCRIBE=config
# owner-only | allowlist | anyone | nobody
BUZZ_ACP_RESPOND_TO=owner-only
# default | acceptEdits | bypassPermissions | plan
BUZZ_ACP_PERMISSION_MODE=bypassPermissions

# Path to the subscription-rules file (mounted into the container).
BUZZ_ACP_CONFIG=/opt/agent/buzz-acp.toml

# NOTE: buzz-acp.toml is parsed literally (no env substitution). Edit the
# channel UUID directly in that file before starting.
